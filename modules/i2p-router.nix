{ config
, lib
, pkgs
, ...
}:
let
  cfg = config.i2p-router;

  user = "i2p";
  group = "i2p";
  configDir = "/var/lib/i2p/i2p-config";
  distDir = "/var/lib/i2p-config-dist";
  secretDir = "/var/lib/i2p-secrets";
  consoleRealm = "i2prouter";

  enabledSites = lib.filterAttrs (_: site: site.enable) cfg.sites;

  secretEnabled = name: config.nix-secrets.secrets.${name}.enable or false;

  consoleNeedsSecret = cfg.console.enable && cfg.console.auth;
  consoleReady = !consoleNeedsSecret || secretEnabled cfg.console.passwordSecret;
  sitesReady = builtins.all
    (site: secretEnabled site.keySecret)
    (builtins.attrValues enabledSites);
  secretsAvailable = config.nix-secrets.enable && consoleReady && sitesReady;

  containerReady = cfg.enable && cfg.externalInterface != null && secretsAvailable;

  bool = lib.boolToString;

  logLevel = {
    debug = "DEBUG";
    info = "INFO";
    warn = "WARN";
    error = "ERROR";
  }.${cfg.logLevel};

  effectiveShare = if cfg.notransit then 0 else cfg.share;

  optionalLine = condition: text: lib.optionalString condition "${text}\n";

  nullIntOption = description: lib.mkOption {
    type = lib.types.nullOr lib.types.int;
    default = null;
    inherit description;
  };

  routerConfig = ''
    # Generated by i2p-router.nix. Do not edit.
    router.updateDisabled=true
    router.sharePercentage=${toString effectiveShare}
    # Declare the first-run wizard as complete so the console goes straight to
    # /home with the configured language and theme.
    routerconsole.welcomeWizardComplete=true
    routerconsole.lang=${cfg.console.language}
    routerconsole.country=
    routerconsole.theme=${cfg.console.theme}
    routerconsole.universal.theme=${bool cfg.console.universalTheming}
    routerconsole.embedApps=${bool cfg.console.embedApps}
    ${optionalLine cfg.i2cp.auth "i2cp.auth=true"}router.floodfillParticipant=${bool cfg.floodfill}
    router.maxParticipatingTunnels=${toString cfg.transitTunnels}
    i2np.ntcp.port=${toString cfg.peerPort}
    i2np.udp.port=${toString cfg.peerPort}
    i2np.udp.internalPort=${toString cfg.peerPort}
    ${optionalLine (cfg.bandwidth.inbound != null) "i2np.bandwidth.inboundKBytesPerSecond=${toString cfg.bandwidth.inbound}"}${optionalLine (cfg.bandwidth.outbound != null) "i2np.bandwidth.outboundKBytesPerSecond=${toString cfg.bandwidth.outbound}"}${optionalLine (cfg.bandwidth.inboundBurst != null) "i2np.bandwidth.inboundBurstKBytesPerSecond=${toString cfg.bandwidth.inboundBurst}"}${optionalLine (cfg.bandwidth.outboundBurst != null) "i2np.bandwidth.outboundBurstKBytesPerSecond=${toString cfg.bandwidth.outboundBurst}"}${optionalLine (cfg.bandwidth.inboundBurstPeak != null) "i2np.bandwidth.inboundBurstKBytes=${toString cfg.bandwidth.inboundBurstPeak}"}${optionalLine (cfg.bandwidth.outboundBurstPeak != null) "i2np.bandwidth.outboundBurstKBytes=${toString cfg.bandwidth.outboundBurstPeak}"}
  '';

  loggerConfig = ''
    # Generated by i2p-router.nix. Do not edit.
    logger.defaultLevel=${logLevel}
  '';

  subscriptionsConfig =
    lib.concatMapStringsSep "\n"
      (sub: "# ${sub.name}\n${sub.url}")
      cfg.addressBook.subscriptions
    + "\n";

  webappsConfig = ''
    # Generated by i2p-router.nix. Do not edit.
    webapps.addressbook.startOnLoad=${bool cfg.webapps.addressbook}
    webapps.i2psnark.startOnLoad=${bool cfg.webapps.i2psnark}
    webapps.i2ptunnel.startOnLoad=${bool cfg.webapps.i2ptunnel}
    webapps.imagegen.startOnLoad=${bool cfg.webapps.imagegen}
    webapps.jsonrpc.startOnLoad=${bool cfg.webapps.jsonrpc}
    webapps.routerconsole.startOnLoad=${bool cfg.console.enable}
    webapps.susidns.startOnLoad=${bool cfg.webapps.susidns}
    webapps.susimail.startOnLoad=${bool cfg.webapps.susimail}
  '';

  webConsoleClientConfig = ''
    clientApp.0.main=net.i2p.router.web.RouterConsoleRunner
    clientApp.0.name=I2P Router Console
    clientApp.0.args=${toString cfg.console.port} 0.0.0.0 ./webapps/
    clientApp.0.onBoot=true
    clientApp.0.startOnLoad=true
  '';

  tunnelClientConfig = ''
    clientApp.0.main=net.i2p.i2ptunnel.TunnelControllerGroup
    clientApp.0.name=Application tunnels
    clientApp.0.args=i2ptunnel.config
    clientApp.0.startOnLoad=true
  '';

  httpProxyTunnelConfig = ''
    name=I2P HTTP Proxy
    description=I2P HTTP proxy for .i2p sites
    type=httpclient
    interface=0.0.0.0
    listenPort=${toString cfg.httpProxy.port}
    sharedClient=true
    i2cpHost=127.0.0.1
    i2cpPort=7654
    startOnLoad=true
  '';

  socksProxyTunnelConfig = ''
    name=I2P SOCKS Proxy
    description=I2P SOCKS proxy for .i2p destinations
    type=sockstunnel
    interface=0.0.0.0
    listenPort=${toString cfg.socksProxy.port}
    sharedClient=true
    i2cpHost=127.0.0.1
    i2cpPort=7654
    startOnLoad=true
  '';

  siteTunnelConfig = name: site: ''
    name=${name}
    description=${name} I2P site
    type=${if site.type == "http" then "httpserver" else "server"}
    targetHost=${site.host}
    targetPort=${toString site.port}
    privKeyFile=${configDir}/${name}-keys.dat
    i2cpHost=127.0.0.1
    i2cpPort=7654
    ${optionalLine (site.type == "http" && site.hostOverride != null) "spoofedHost=${site.hostOverride}"}startOnLoad=true
  '';

  siteTunnelFiles = lib.mapAttrsToList
    (name: site: {
      source = pkgs.writeText "i2p-${name}-tunnel.config" (siteTunnelConfig name site);
      target = "${name}.config";
    })
    enabledSites;

  configDist = pkgs.runCommand "i2p-java-config" { } ''
    mkdir -p $out/addressbook $out/clients.config.d $out/i2ptunnel.config.d
    cp ${pkgs.writeText "i2p-router.config" routerConfig} $out/router.config
    cp ${pkgs.writeText "i2p-logger.config" loggerConfig} $out/logger.config
    cp ${pkgs.writeText "i2p-webapps.config" webappsConfig} $out/webapps.config
    cp ${pkgs.writeText "i2p-subscriptions.txt" subscriptionsConfig} \
      $out/addressbook/subscriptions.txt
    ${lib.optionalString cfg.console.enable ''
      cp ${pkgs.writeText "i2p-webconsole-client.config" webConsoleClientConfig} \
        $out/clients.config.d/00-webconsole.config
    ''}
    cp ${pkgs.writeText "i2p-tunnel-client.config" tunnelClientConfig} \
      $out/clients.config.d/01-tunnels.config
    ${lib.optionalString cfg.httpProxy.enable ''
      cp ${pkgs.writeText "i2p-http-proxy-tunnel.config" httpProxyTunnelConfig} \
        $out/i2ptunnel.config.d/00-http-proxy.config
    ''}
    ${lib.optionalString cfg.socksProxy.enable ''
      cp ${pkgs.writeText "i2p-socks-proxy-tunnel.config" socksProxyTunnelConfig} \
        $out/i2ptunnel.config.d/01-socks-proxy.config
    ''}
    ${lib.concatMapStringsSep "\n" (file: ''
      cp ${file.source} $out/i2ptunnel.config.d/${file.target}
    '') siteTunnelFiles}
  '';

  siteKeySecrets = lib.mapAttrsToList (_: site: site.keySecret) enabledSites;

  siteBindMounts = lib.listToAttrs (
    lib.mapAttrsToList
      (name: site: {
        name = "${secretDir}/sites/${name}.dat";
        value = {
          hostPath = config.security.nix-secrets.secrets.${site.keySecret}.path;
          isReadOnly = true;
        };
      })
      enabledSites
  );

  siteKeyCopies = lib.concatMapStringsSep "\n"
    (name: ''
      "$install_bin" -o "$owner" -g "$group" -m 0400 \
        "$secret_dir/sites/${name}.dat" "$config_dir/${name}-keys.dat"
    '')
    (builtins.attrNames enabledSites);

  # Java I2P stores the router console password as an MD5 hash in
  # router.config. The hash is derived from the age secret at runtime so the
  # plaintext never leaves nix-secrets.
  preStartScript = pkgs.writeShellScript "i2p-pre-start" ''
    set -euo pipefail

    config_dir=${lib.escapeShellArg configDir}
    dist_dir=${lib.escapeShellArg distDir}
    secret_dir=${lib.escapeShellArg secretDir}
    owner=${lib.escapeShellArg user}
    group=${lib.escapeShellArg group}
    install_bin=${lib.escapeShellArg "${pkgs.coreutils}/bin/install"}
    rm_bin=${lib.escapeShellArg "${pkgs.coreutils}/bin/rm"}
    cat_bin=${lib.escapeShellArg "${pkgs.coreutils}/bin/cat"}
    basename_bin=${lib.escapeShellArg "${pkgs.coreutils}/bin/basename"}
    md5sum_bin=${lib.escapeShellArg "${pkgs.coreutils}/bin/md5sum"}
    cut_bin=${lib.escapeShellArg "${pkgs.coreutils}/bin/cut"}

    "$install_bin" -d -o "$owner" -g "$group" -m 0700 "$config_dir"
    "$rm_bin" -rf "$config_dir/clients.config.d" "$config_dir/i2ptunnel.config.d"
    "$install_bin" -d -o "$owner" -g "$group" -m 0700 \
      "$config_dir/clients.config.d" "$config_dir/i2ptunnel.config.d" \
      "$config_dir/addressbook"

    "$install_bin" -o "$owner" -g "$group" -m 0400 \
      "$dist_dir/addressbook/subscriptions.txt" \
      "$config_dir/addressbook/subscriptions.txt"

    for file in "$dist_dir"/*.config; do
      [ -e "$file" ] || continue
      target=$("$basename_bin" "$file")
      "$install_bin" -o "$owner" -g "$group" -m 0400 "$file" "$config_dir/$target"
    done

    for dir in clients.config.d i2ptunnel.config.d; do
      for file in "$dist_dir/$dir"/*.config; do
        [ -e "$file" ] || continue
        target=$("$basename_bin" "$file")
        "$install_bin" -o "$owner" -g "$group" -m 0400 \
          "$file" "$config_dir/$dir/$target"
      done
    done

    ${lib.optionalString consoleNeedsSecret ''
      password=$("$cat_bin" "$secret_dir/console/password")
      hash=$(printf '%s:%s:%s' \
        ${lib.escapeShellArg cfg.console.user} \
        ${lib.escapeShellArg consoleRealm} \
        "$password" | "$md5sum_bin" | "$cut_bin" -d' ' -f1)
      {
        printf 'routerconsole.auth.enable=true\n'
        printf 'routerconsole.auth.i2prouter.%s.md5=%s\n' \
          ${lib.escapeShellArg cfg.console.user} "$hash"
      } >> "$config_dir/router.config"
    ''}
    ${lib.optionalString (!consoleNeedsSecret) ''
      printf 'routerconsole.auth.enable=false\n' >> "$config_dir/router.config"
    ''}

    ${siteKeyCopies}
  '';

  javaOptions = lib.concatStringsSep " " (
    [ "-Di2p.dir.config=${configDir}" ]
    ++ lib.optional (!cfg.ipv6) "-Djava.net.preferIPv4Stack=true"
  );

  proxyForwards = lib.optionals cfg.console.enable [
    {
      sourcePort = cfg.console.port;
      destination = "${cfg.localAddress}:${toString cfg.console.port}";
      loopbackIPs = [ "127.0.0.1" ] ++ cfg.extraLoopbackIPs;
    }
  ]
  ++ lib.optionals cfg.httpProxy.enable [
    {
      sourcePort = cfg.httpProxy.port;
      destination = "${cfg.localAddress}:${toString cfg.httpProxy.port}";
      loopbackIPs = [ "127.0.0.1" ] ++ cfg.extraLoopbackIPs;
    }
  ]
  ++ lib.optionals cfg.socksProxy.enable [
    {
      sourcePort = cfg.socksProxy.port;
      destination = "${cfg.localAddress}:${toString cfg.socksProxy.port}";
      loopbackIPs = [ "127.0.0.1" ] ++ cfg.extraLoopbackIPs;
    }
  ];

  containerPorts = [ ]
    ++ lib.optional cfg.console.enable cfg.console.port
    ++ lib.optional cfg.httpProxy.enable cfg.httpProxy.port
    ++ lib.optional cfg.socksProxy.enable cfg.socksProxy.port
    ++ [ cfg.peerPort ];
in
{
  options.i2p-router = {
    enable = lib.mkEnableOption "Java I2P router in a NixOS container";

    package = lib.mkOption {
      type = lib.types.package;
      default = pkgs.i2p;
      defaultText = lib.literalExpression "pkgs.i2p";
      description = "Java I2P package to run inside the container.";
    };

    externalInterface = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      example = "enp44s0";
      description = ''
        Host interface used for NAT and for forwarding the router's peer port.
        Required when the router is enabled.
      '';
    };

    hostAddress = lib.mkOption {
      type = lib.types.str;
      default = "10.235.0.1";
      description = "Host-side address of the private container network. Site backends on the host are reached at this address.";
    };

    localAddress = lib.mkOption {
      type = lib.types.str;
      default = "10.235.0.2";
      description = "Container-side address of the private container network.";
    };

    network = lib.mkOption {
      type = lib.types.str;
      default = "10.235.0.0/24";
      description = "Private container network in CIDR notation, used for NAT.";
    };

    dns = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ "1.1.1.1" "1.0.0.1" ];
      description = "DNS servers used inside the container.";
    };

    extraLoopbackIPs = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      example = [ "100.98.50.57" ];
      description = ''
        Extra addresses allowed to reach the forwarded proxy ports, in
        addition to 127.0.0.1. Add this host's Tailscale address so other
        hosts in the PAC fallback list can use these proxies.
      '';
    };

    peerPort = lib.mkOption {
      type = lib.types.port;
      default = 8887;
      description = "I2NP peer port, forwarded to the container over TCP and UDP.";
    };

    openFirewall = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Open the peer port on the host firewall for incoming I2P connections.";
    };

    logLevel = lib.mkOption {
      type = lib.types.enum [ "debug" "info" "warn" "error" ];
      default = "error";
      description = "Java I2P log level.";
    };

    ipv4 = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Use IPv4 for I2P peer connections.";
    };

    ipv6 = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Use IPv6 for I2P peer connections.";
    };

    notransit = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Do not carry transit traffic for other routers.";
    };

    floodfill = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Act as a floodfill router.";
    };

    share = lib.mkOption {
      type = lib.types.ints.between 0 100;
      default = 100;
      description = "Percentage of bandwidth shared as transit traffic.";
    };

    i2cp = {
      auth = lib.mkOption {
        type = lib.types.bool;
        default = false;
        description = "Require a username and password for socket I2CP clients.";
      };
    };

    bandwidth = lib.mkOption {
      default = { };
      type = lib.types.submodule {
        options = {
          inbound = nullIntOption "Sustained inbound bandwidth in KiB/s. Null lets Java I2P auto-detect.";
          outbound = nullIntOption "Sustained outbound bandwidth in KiB/s. Null lets Java I2P auto-detect.";
          inboundBurst = nullIntOption "Inbound burst bandwidth in KiB/s.";
          outboundBurst = nullIntOption "Outbound burst bandwidth in KiB/s.";
          inboundBurstPeak = nullIntOption "Maximum inbound burst size in KiB.";
          outboundBurstPeak = nullIntOption "Maximum outbound burst size in KiB.";
        };
      };
      description = "Bandwidth limits written to router.config.";
    };

    transitTunnels = lib.mkOption {
      type = lib.types.int;
      default = 2500;
      description = "Maximum number of active transit tunnels.";
    };

    console = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Enable the Java I2P router console.";
      };

      port = lib.mkOption {
        type = lib.types.port;
        default = 7070;
        description = "Console port, reachable from the host at 127.0.0.1.";
      };

      auth = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Require HTTP digest authentication for the router console.";
      };

      user = lib.mkOption {
        type = lib.types.str;
        default = "i2p";
        description = "Router console username.";
      };

      passwordSecret = lib.mkOption {
        type = lib.types.str;
        default = "i2p/console/password";
        description = "nix-secrets secret containing the router console password.";
      };

      language = lib.mkOption {
        type = lib.types.str;
        default = "en";
        description = "Console language written to router.config.";
      };

      theme = lib.mkOption {
        type = lib.types.str;
        default = "dark";
        description = "Console theme written to router.config.";
      };

      universalTheming = lib.mkOption {
        type = lib.types.bool;
        default = false;
        description = "Apply the console theme to bundled web applications.";
      };

      embedApps = lib.mkOption {
        type = lib.types.bool;
        default = false;
        description = "Display bundled web applications inside the console frame.";
      };
    };

    httpProxy = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Enable Java I2P's HTTP proxy for browsing .i2p sites.";
      };

      port = lib.mkOption {
        type = lib.types.port;
        default = 4444;
        description = "HTTP proxy port, reachable from the host at 127.0.0.1.";
      };
    };

    socksProxy = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Enable Java I2P's SOCKS proxy.";
      };

      port = lib.mkOption {
        type = lib.types.port;
        default = 4447;
        description = "SOCKS proxy port, reachable from the host at 127.0.0.1.";
      };
    };

    webapps = lib.mkOption {
      default = { };
      type = lib.types.submodule {
        options = {
          addressbook = lib.mkOption {
            type = lib.types.bool;
            default = false;
            description = "Start the address book webapp on router startup.";
          };
          i2psnark = lib.mkOption {
            type = lib.types.bool;
            default = true;
            description = "Start the I2PSnark webapp on router startup.";
          };
          i2ptunnel = lib.mkOption {
            type = lib.types.bool;
            default = true;
            description = "Start the I2PTunnel webapp on router startup.";
          };
          imagegen = lib.mkOption {
            type = lib.types.bool;
            default = false;
            description = "Start the imagegen webapp on router startup.";
          };
          jsonrpc = lib.mkOption {
            type = lib.types.bool;
            default = false;
            description = "Start the JSON-RPC webapp on router startup.";
          };
          susidns = lib.mkOption {
            type = lib.types.bool;
            default = false;
            description = "Start the SusiDNS webapp on router startup.";
          };
          susimail = lib.mkOption {
            type = lib.types.bool;
            default = false;
            description = "Start the SusiMail webapp on router startup.";
          };
        };
      };
      description = "Bundled Java I2P webapps to start with the router.";
    };

    addressBook = {
      subscriptions = lib.mkOption {
        type = lib.types.listOf (
          lib.types.submodule {
            options = {
              name = lib.mkOption {
                type = lib.types.str;
                description = "Display name written as a comment before the URL.";
              };
              url = lib.mkOption {
                type = lib.types.str;
                description = "Address book subscription URL.";
              };
            };
          }
        );
        default = [
          {
            name = "Official I2P";
            url = "http://i2p-projekt.i2p/hosts.txt";
          }
          {
            name = "Stats.i2p";
            url = "http://stats.i2p/cgi-bin/newhosts.txt";
          }
          {
            name = "I2Host";
            url = "http://i2host.i2p/cgi-bin/i2hostetag";
          }
          {
            name = "Identiguy";
            url = "http://identiguy.i2p/hosts.txt";
          }
        ];
        description = "Address book subscriptions written to addressbook/subscriptions.txt.";
      };
    };

    sites = lib.mkOption {
      default = { };
      type = lib.types.attrsOf (
        lib.types.submodule (
          { name, ... }:
          {
            options = {
              enable = lib.mkEnableOption "this I2P site" // { default = true; };

              type = lib.mkOption {
                type = lib.types.enum [ "http" "server" ];
                default = "http";
                description = ''
                  Use `http` for a website (sets the Host header) or `server`
                  for any other TCP service.
                '';
              };

              host = lib.mkOption {
                type = lib.types.str;
                default = cfg.hostAddress;
                defaultText = lib.literalExpression "cfg.hostAddress";
                description = ''
                  Address of the local backend service as seen from the
                  container. Defaults to the host's container address; use
                  127.0.0.1 for a backend running inside the container.
                '';
              };

              port = lib.mkOption {
                type = lib.types.port;
                description = "Port of the local backend service.";
              };

              hostOverride = lib.mkOption {
                type = lib.types.nullOr lib.types.str;
                default = null;
                description = "Host header sent to the backend for http tunnels.";
              };

              keySecret = lib.mkOption {
                type = lib.types.str;
                default = "i2p/sites/${name}/keys";
                description = ''
                  nix-secrets secret holding this site's private destination
                  key. Java I2P uses the eepPriv.dat format, which is also
                  compatible with i2pd key files.
                '';
              };
            };
          }
        )
      );
      description = ''
        Hidden services hosted by this router. Each site needs a key secret
        in nix-secrets; the .i2p address is derived from that key.
      '';
    };
  };

  config = lib.mkMerge [
    {
      assertions = [
        {
          assertion = !cfg.enable || cfg.externalInterface != null;
          message = "i2p-router.enable requires i2p-router.externalInterface.";
        }
        {
          assertion = !cfg.enable || secretsAvailable;
          message = ''
            i2p-router is enabled, but its secrets are not available on this host.
            Enable nix-secrets and make sure ${cfg.console.passwordSecret} (when
            console auth is on) and the keySecret of every enabled site are enabled.
          '';
        }
        {
          assertion = lib.length siteKeySecrets == lib.length (lib.unique siteKeySecrets);
          message = "i2p-router sites must not share the same keySecret.";
        }
        {
          assertion = builtins.all
            (name: builtins.match "[A-Za-z0-9_-]+" name != null)
            (builtins.attrNames cfg.sites);
          message = "i2p-router site names may only contain letters, digits, underscores and dashes.";
        }
        {
          assertion = !cfg.console.auth || builtins.match "[A-Za-z0-9_-]+" cfg.console.user != null;
          message = "i2p-router console user may only contain letters, digits, underscores and dashes.";
        }
        {
          assertion = builtins.match "[A-Za-z_]+" cfg.console.language != null;
          message = "i2p-router console language may only contain letters and underscores.";
        }
        {
          assertion = builtins.match "[A-Za-z0-9_-]+" cfg.console.theme != null;
          message = "i2p-router console theme may only contain letters, digits, underscores and dashes.";
        }
        {
          assertion = builtins.all
            (sub:
              builtins.replaceStrings [ "\n" "\r" ] [ "" ] sub.name == sub.name &&
              builtins.replaceStrings [ "\n" "\r" ] [ "" ] sub.url == sub.url)
            cfg.addressBook.subscriptions;
          message = "i2p-router address book subscription names and URLs must not contain newlines.";
        }
      ];
    }

    # Declare secrets as soon as the router is enabled so `nix-secrets edit`
    # can create them before the first successful rebuild.
    (lib.mkIf cfg.enable {
      nix-secrets.secrets =
        {
          "${cfg.console.passwordSecret}" = { };
        }
        // lib.listToAttrs (
          lib.mapAttrsToList
            (name: site: {
              name = site.keySecret;
              value = { };
            })
            enabledSites
        );
    })

    (lib.mkIf containerReady {
      # A failed Java I2P process exits the container with a non-zero status.
      # Do not let the host respawn an empty router.
      systemd.services."container@i2p-router".serviceConfig.Restart = lib.mkForce "no";

      networking.nat = {
        enable = true;
        inherit (cfg) externalInterface;
        internalIPs = [ cfg.network ];
        forwardPorts = proxyForwards ++ [
          {
            sourcePort = cfg.peerPort;
            destination = "${cfg.localAddress}:${toString cfg.peerPort}";
            proto = "tcp";
          }
          {
            sourcePort = cfg.peerPort;
            destination = "${cfg.localAddress}:${toString cfg.peerPort}";
            proto = "udp";
          }
        ];
      };

      networking.firewall = lib.mkIf cfg.openFirewall {
        allowedTCPPorts = [ cfg.peerPort ];
        allowedUDPPorts = [ cfg.peerPort ];
      };

      containers.i2p-router = {
        autoStart = true;
        privateNetwork = true;
        hostAddress = cfg.hostAddress;
        localAddress = cfg.localAddress;

        bindMounts = {
          "${distDir}" = {
            hostPath = "${configDist}";
            isReadOnly = true;
          };
        }
        // lib.optionalAttrs consoleNeedsSecret {
          "${secretDir}/console/password" = {
            hostPath = config.security.nix-secrets.secrets.${cfg.console.passwordSecret}.path;
            isReadOnly = true;
          };
        }
        // siteBindMounts;

        config =
          { lib, pkgs, ... }:
          {
            system.stateVersion = "26.05";

            networking = {
              useHostResolvConf = lib.mkForce false;
              nameservers = cfg.dns;
              firewall = {
                enable = true;
                allowedTCPPorts = containerPorts;
                allowedUDPPorts = [ cfg.peerPort ];
              };
            };

            services.i2p = {
              enable = true;
            };

            systemd.services.i2p = {
              after = [ "network-online.target" ];
              serviceConfig = {
                # NixOS' services.i2p module has no package option, so pin
                # ExecStart to the package selected by this module.
                ExecStart = lib.mkForce "${cfg.package}/bin/i2prouter";
                # The bind-mounted secrets stay root-owned, so this runs as
                # root via systemd's "+" prefix. It installs generated config
                # files and copies secrets into I2P's writable config dir.
                ExecStartPre = "+${preStartScript}";
                Restart = lib.mkForce "no";
                FailureAction = "exit";
                FailureActionExitStatus = 1;
                Environment = [
                  "JAVA_TOOL_OPTIONS=${javaOptions}"
                ];
              };
            };
          };
      };
    })
  ];
}
